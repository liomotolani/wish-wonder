# Supabase project URL (local development: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase secret service role key (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Public web application base URL for generating invite and personal links
# Leave this out (or as localhost) during local/LAN development; request host is used.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extra hostnames allowed to load Next.js dev assets, comma-separated.
# LAN/private IPs and *.local are allowed automatically. Add a tunnel hostname here.
# ALLOWED_DEV_ORIGINS=my-tunnel.example.com
